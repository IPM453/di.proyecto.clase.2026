<Window x:Class="di.proyecto.clase_2026.Vista.Dialogos.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.proyecto.clase_2026.Vista.Dialogos"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0">
    <Grid>
        <Grid>
            <Grid Margin="50" Background="#DE243A">

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,30,0,0">
                    <TextBlock Text="Bienvenidos !" Foreground="White"
                   FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="INVENTARIO MATISSE" Foreground="White"
                   FontSize="14" Margin="0,18,0,0"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,25">
                    <Image Source="/Recursos/iconos/matisse.png" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="IES HENRI MATISSE" Foreground="White" FontSize="11"/>
                </StackPanel>
            </Grid>
            <Grid Background="White" Width="300" Height="400"
          HorizontalAlignment="Right" Margin="0,0,100,0">

                <StackPanel Margin="45,35,45,0">
                    <TextBlock Text="LOGIN" Foreground="#DE243A"
                       FontSize="24" HorizontalAlignment="Center"/>

                    <TextBox Margin="0,40,0,0"
                     Style="{StaticResource MaterialDesignTextBox}"
                     mat:HintAssist.Hint="Nombre de Usuario"
                     FontSize="13" x:Name="txtUser"/>

                    <PasswordBox Margin="0,22,0,0"
                         Style="{StaticResource MaterialDesignPasswordBox}"
                         mat:HintAssist.Hint="Clave de Acceso"
                         FontSize="13" x:Name="passClave"/>

                    <Button Content="LOGIN" Height="32" Margin="0,40,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Foreground="White" Background="#DE243A" FontWeight="Bold"
                    x:Name="btnLogin" Click="btnLogin_Click"/>

                    <Button Content="¿TIENES CUENTA?" Height="34" Margin="0,28,0,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Background="White"
                    BorderBrush="#BBBBBB" FontWeight="Bold"/>

                    <Button Content="¿Olvidaste la Contraseña?" HorizontalAlignment="Center"
                       Margin="0,38,0,0" FontWeight="SemiBold" Foreground="#DE243A" Background="Transparent" BorderBrush="Transparent"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
